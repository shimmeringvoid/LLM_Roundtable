# API keys for LLM Roundtable.
#
# You can skip this file: the script asks for any key it can't find and offers
# to save it for you. To set the keys by hand instead, copy this file to ".env"
# (same folder) and paste each key after its "=" sign, with no spaces or quotes.
#
# Never commit the real .env file. It is listed in .gitignore.

OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
